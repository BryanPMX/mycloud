APP_NAME=MyCloud-validation
APP_ENV=development
APP_BASE_URL=http://127.0.0.1:59139
ALLOWED_ORIGINS=http://127.0.0.1:59139
PORT=8080
DATABASE_URL=postgres://validation:validation-only-local@postgres:5432/mycloud_validation?sslmode=disable
REDIS_URL=redis://redis:6379/0
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=validation
MINIO_SECRET_KEY=validation-only-local
MINIO_SECURE=false
MINIO_PUBLIC_ENDPOINT=127.0.0.1:59039
MINIO_PUBLIC_SECURE=false
MINIO_UPLOADS_BUCKET=fc-uploads
MINIO_ORIGINALS_BUCKET=fc-originals
MINIO_THUMBS_BUCKET=fc-thumbs
MINIO_AVATARS_BUCKET=fc-avatars
CLAMAV_SOCKET=tcp://clamav:3310
JWT_SECRET=validation-only-secret-at-least-32-bytes-never-use-in-production
JWT_ISSUER=mycloud-validation
CLEANUP_INTERVAL_MINUTES=1
