GHCR_OWNER=your-github-user-or-org
IMAGE_TAG=sha-REPLACE_WITH_REVIEWED_COMMIT

APP_NAME=MyCloud
APP_ENV=production
APP_BASE_URL=https://mynube.live
PORT=8080

POSTGRES_USER=mycloud
POSTGRES_PASSWORD=replace-with-strong-password
DATABASE_URL=postgres://mycloud:replace-with-strong-password@postgres:5432/mycloud?sslmode=disable

REDIS_PASSWORD=replace-with-strong-password
REDIS_URL=redis://:replace-with-strong-password@redis:6379/0

# Administrative identity only; preserve existing production root values privately.
MINIO_ROOT_USER=replace-with-minio-root-user
MINIO_ROOT_PASSWORD=replace-with-minio-root-password-long

# Dedicated least-privilege identity used by the API and worker.
MINIO_ACCESS_KEY=replace-with-minio-app-access-key
MINIO_SECRET_KEY=replace-with-minio-app-secret-key-long
MINIO_ENDPOINT=minio:9000
MINIO_SECURE=false
MINIO_PUBLIC_ENDPOINT=minio.mynube.live
MINIO_PUBLIC_SECURE=true
MINIO_UPLOADS_BUCKET=fc-uploads
MINIO_ORIGINALS_BUCKET=fc-originals
MINIO_THUMBS_BUCKET=fc-thumbs
MINIO_AVATARS_BUCKET=fc-avatars

CLAMAV_SOCKET=tcp://clamav:3310
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=mailer@example.com
SMTP_PASS=replace-with-smtp-password
SMTP_FROM=MyCloud <no-reply@mynube.live>

JWT_SECRET=replace-with-32-bytes-or-more
JWT_ISSUER=mycloud
JWT_ACCESS_TTL_MINUTES=15
JWT_REFRESH_TTL_DAYS=30
CLEANUP_INTERVAL_MINUTES=60

API_BIND_PORT=8080
MINIO_BIND_PORT=9000
MINIO_CONSOLE_BIND_PORT=9001

# Exact NPM container IP or a tightly scoped NPM-only proxy subnet.
TRUSTED_PROXIES=172.18.0.4/32
ALLOWED_ORIGINS=https://mynube.live,https://www.mynube.live
API_CPUS=1.0
API_MEMORY_LIMIT=512m
WORKER_CPUS=1.0
WORKER_MEMORY_LIMIT=1536m
CLAMAV_CPUS=1.0
CLAMAV_MEMORY_LIMIT=4g

MINIO_REGION=us-east-1

# Remaining MyCloud service bounds; these are maximums, not RAM reservations.
POSTGRES_CPUS=1.0
POSTGRES_MEMORY_LIMIT=768m
REDIS_CPUS=0.5
REDIS_MEMORY_LIMIT=512m
REDIS_MAXMEMORY=128mb
MINIO_CPUS=1.0
MINIO_MEMORY_LIMIT=1g
MINIO_GO_MEMORY_LIMIT=768MiB

# Preserve the current named volume until the guarded SSD migration is verified.
MYCLOUD_MINIO_STORAGE_FILE=storage/minio-volume.yml
# After migration only: storage/minio-ssd.yml, plus the prepared UUID and host guard.
# MYCLOUD_STORAGE_UUID=REPLACE_WITH_PREPARED_EXT4_UUID
