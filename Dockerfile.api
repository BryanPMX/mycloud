FROM --platform=$BUILDPLATFORM golang:1.26.10-alpine@sha256:87c65a688975c0b1d4585d204874c45ca78354670e3a5f11368c5a492303d696 AS builder

WORKDIR /app
RUN apk add --no-cache git

ARG TARGETOS
ARG TARGETARCH

COPY go.mod go.sum ./
RUN go mod download

COPY . .
RUN CGO_ENABLED=0 GOOS=$TARGETOS GOARCH=$TARGETARCH go build -trimpath -o /bin/mycloud-api ./cmd/server

FROM alpine:3.22@sha256:49340b346798875b5592e5d420241f2f9cfba5f47e62ebb1446a1b34734e898f

RUN apk add --no-cache ca-certificates tzdata
RUN addgroup -S -g 10001 mycloud && adduser -S -D -H -u 10001 -G mycloud mycloud
WORKDIR /app
USER 10001:10001

COPY --from=builder /bin/mycloud-api /bin/mycloud-api

EXPOSE 8080
CMD ["/bin/mycloud-api"]
